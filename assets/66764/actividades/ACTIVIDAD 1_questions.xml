<!-- question: 3  -->
  <question type="multichoice">
    <name>
      <text>Pregunta 3</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<strong>3.</strong> ¿Cuáles son los cuatro (4) elementos fundamentales de programación orientada a objetos?]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[a. Herencia, imaginación, encapsulamiento, polimorfismo.]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[b. Polimorfismo, abstracción, herencia, encapsulamiento. <strong></strong>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[c. Gerencia, encapsulamiento, polimorfismo, accesibilidad.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[d. Accesibilidad, polimorfismo, encapsulamiento, herencia.]]></text>
    </answer>
  </question>

<!-- question: 4  -->
  <question type="multichoice">
    <name>
      <text>Pregunta 4</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<strong>4.</strong> ¿Cuál es la diferencia entre clase y objeto?]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[a. Una clase es una representación imaginaria de objetos de un mismo tipo mientras que un objeto es un componente de la clase.]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[b. Una clase es la representación abstracta de objetos de un mismo tipo mientras que un objeto es una instanciación de una clase.<strong></strong>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[c. Una clase y un objeto son lo mismo.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[d. Un objeto es una representación abstracta de una clase mientras que la clase es una instanciación de un objeto.]]></text>
    </answer>
  </question>

<!-- question: 5  -->
  <question type="multichoice">
    <name>
      <text>Pregunta 5</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<strong>5.</strong> ¿Qué es encapsulamiento?]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[a. Es el mecanismo por el cual desprotegemos la información de un objeto permitiendo su acceso de forma directa.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[b. Es el mecanismo por el cual podemos acceder a los atributos y métodos de una clase <strong><em>A</em></strong> en una clase <strong><em>B.</em></strong>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[c. Es el mecanismo por el cual protegemos la información de un objeto permitiendo su acceso a través de sus métodos. <strong></strong>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[d. Es el mecanismo por el cual podemos heredar los atributos y métodos de una clase <strong><em>A</em></strong> en una clase <strong><em>B.</em></strong>]]></text>
    </answer>
  </question>

