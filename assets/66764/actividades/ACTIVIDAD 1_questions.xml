  <question type="multichoice">
    <name>
      <text>Pregunta 1</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<strong>1.</strong> ¿Cuál de las siguientes descripciones define mejor el concepto de <em>clase</em> en programación orientada a objetos?]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[a. Es un concepto similar al de <em>array </em>o vector.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[b. Es un tipo particular de variable.]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[c. Es un modelo o plantilla <em>(blueprint)</em> a partir de la cual creamos objetos. <strong></strong>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[d. Es una categoría de datos ordenada secuencialmente.]]></text>
    </answer>
  </question>

