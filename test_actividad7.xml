      <text><![CDATA[44.5 minutos]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[45.0 minutos]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[46.2 minutos]]></text>
